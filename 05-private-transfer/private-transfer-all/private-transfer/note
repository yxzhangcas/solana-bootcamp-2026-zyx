yxzhang@SolanaLearn:private-transfer-all$ cd private-transfer/
yxzhang@SolanaLearn:private-transfer$ rm -rf app/ migrations/ .gitignore .prettierignore
yxzhang@SolanaLearn:private-transfer$ anchor build
yxzhang@SolanaLearn:private-transfer$ anchor test # 提交git作为初始版本
# [CODE]
yxzhang@SolanaLearn:private-transfer$ anchor build # 提交git，进行verifier的开发
# [DEPLOY]
# 修改program中的verifier的programId：HELhybP3HoggrnWfAxH8Bzc2V98g9sLJg72Xnpv8dyu9
